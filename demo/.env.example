# OpenWebUI LLM Observability Demo
# Copy to .env and fill in your credentials: cp .env.example .env

# ── OpenAI API ───────────────────────────────────────────────
# Get your API key from: https://platform.openai.com/api-keys
OPENAI_API_KEY=your-openai-api-key-here

# ── Anthropic API ────────────────────────────────────────────
# Get your API key from: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=your-anthropic-api-key-here

# ── Gemini API ───────────────────────────────────────────────
# Get your API key from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your-gemini-api-key-here

# ── Grafana Cloud OTLP ──────────────────────────────────────
# Settings -> Connections -> Add Connection -> OpenTelemetry (OTLP)
# Base64-encoded "instance_id:token":  echo -n "ID:TOKEN" | base64
GRAFANA_OTLP_TOKEN=your-base64-encoded-token-here

# OTLP endpoint for your Grafana Cloud region
OTEL_EXPORTER_OTLP_ENDPOINT=https://otlp-gateway-prod-REGION.grafana.net/otlp

# ── OpenWebUI Credentials ───────────────────────────────────
# Used by start-demo.sh and load-gen scripts
OPENWEBUI_EMAIL=team-se@grafana.com
OPENWEBUI_PASSWORD=open-sesame
OPENWEBUI_NAME=Demo User
